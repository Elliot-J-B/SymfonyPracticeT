{% extends 'base.html.twig' %}

{% block title %}Image index{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1>Image index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>image</th>
                <th>crédits</th>
                <th>actions</th>
                

            </tr>
        </thead>
        <tbody>
        {% for image in images %}
            <tr>
                <td>{{ image.id }}</td>
                <td>{{ image.name }}</td>
                <td>
                    <img src="/images/{{ image.name }}" width="55" height="55"/>
                    
                </td>
                <td>
                    {% for credit in image.credits %}
                     {{ credit.authorName }}
                     {% endfor %}
                </td>
                <td>
                    <a href="{{ path('app_image_show', {'id': image.id}) }}">show</a>
                    <a href="{{ path('app_image_edit', {'id': image.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_image_new') }}">Create new</a>
    </div>
{% endblock %}
